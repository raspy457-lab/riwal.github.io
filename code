<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reinabanana - Профиль</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #1a1a1a; /* Темный фон как на скрине */
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            color: #e0e0e0;
            line-height: 1.5;
            padding: 20px;
        }

        /* Основной контейнер - имитация интерфейса */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 2fr 1fr; /* Три колонки: левая, центральная, правая */
            gap: 20px;
            align-items: start;
        }

        /* Общие стили для карточек/блоков */
        .card {
            background-color: #252525;
            border: 1px solid #333;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
        }

        .card-header {
            background-color: #2a2a2a;
            padding: 12px 15px;
            border-bottom: 1px solid #333;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            color: #aaa;
        }

        .card-body {
            padding: 15px;
        }

        /* Левая колонка */
        .left-column .card:first-child .card-body {
            text-align: center;
            padding: 20px;
        }

        .avatar-placeholder {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background-color: #444;
            margin: 0 auto 15px;
            border: 3px solid #666;
        }

        .username {
            font-size: 1.4rem;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .handle {
            color: #888;
            margin-bottom: 15px;
            font-size: 0.9rem;
        }

        .bio {
            font-size: 0.9rem;
            margin-bottom: 15px;
            color: #ccc;
        }

        .joined {
            font-size: 0.8rem;
            color: #777;
        }

        /* Меню навигации */
        .nav-menu {
            list-style: none;
        }

        .nav-menu li {
            padding: 8px 0;
            border-bottom: 1px solid #333;
        }

        .nav-menu li:last-child {
            border-bottom: none;
        }

        .nav-menu a {
            color: #ddd;
            text-decoration: none;
            display: block;
        }

        .search-box {
            background-color: #333;
            border: 1px solid #444;
            color: #fff;
            padding: 8px 12px;
            border-radius: 20px;
            width: 100%;
            margin: 10px 0;
        }

        /* Центральная колонка - посты */
        .post-header {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .post-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #444;
            margin-right: 10px;
        }

        .post-author {
            font-weight: bold;
        }

        .post-meta {
            font-size: 0.8rem;
            color: #777;
        }

        .post-content {
            margin-bottom: 15px;
            font-size: 0.95rem;
        }

        .post-image-placeholder {
            width: 100%;
            height: 200px;
            background: linear-gradient(45deg, #333, #444);
            border-radius: 10px;
            margin: 15px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #777;
        }

        .post-stats {
            border-top: 1px solid #333;
            padding-top: 10px;
            font-size: 0.8rem;
            color: #777;
        }

        /* Карточка персонажа */
        .character-card {
            display: grid;
            grid-template-columns: 60px 1fr;
            gap: 10px;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #333;
        }

        .character-card:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .character-icon {
            width: 60px;
            height: 60px;
            background-color: #444;
            border-radius: 8px;
        }

        .character-info h4 {
            font-size: 1rem;
            margin-bottom: 3px;
            color: #fff;
        }

        .character-sub {
            font-size: 0.75rem;
            color: #aaa;
            margin-bottom: 5px;
        }

        .character-stats {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: #888;
        }

        .stat-value {
            color: #ffaa33;
            font-weight: bold;
        }

        /* Правая колонка */
        .friend-item {
            display: flex;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #333;
        }

        .friend-item:last-child {
            border-bottom: none;
        }

        .friend-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background-color: #444;
            margin-right: 10px;
        }

        .friend-name {
            font-size: 0.9rem;
        }

        .hashtag-list {
            list-style: none;
        }

        .hashtag-list li {
            color: #7aaae0;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .footer-note {
            font-size: 0.7rem;
            color: #666;
            text-align: center;
            margin-top: 20px;
            grid-column: 1 / -1;
        }
    </style>
</head>
