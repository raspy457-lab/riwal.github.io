    <script>
        function switchLanguage(lang) {
            const elements = document.querySelectorAll('[data-ru], [data-en]');
            elements.forEach(el => {
                if (lang === 'ru' && el.hasAttribute('data-ru')) {
                    el.textContent = el.getAttribute('data-ru');
                } else if (lang === 'en' && el.hasAttribute('data-en')) {
                    el.textContent = el.getAttribute('data-en');
                }
            });
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
            });
            localStorage.setItem('selectedLang', lang);
        }

        document.querySelectorAll('.lang-btn').forEach(btn => {
            btn.addEventListener('click', () => switchLanguage(btn.getAttribute('data-lang')));
        });

        const saved = localStorage.getItem('selectedLang');
        switchLanguage(saved || 'ru');
    </script>

